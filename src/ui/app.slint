// Excel配对页面
export component ExcelPage inherits VerticalBox {
    in-out property <int> plan-id: 0;
    
    Text {
        text: "Excel配对";
        font-size: 18px;
        font-weight: 700;
        color: #1976D2;
    }
    
    HorizontalLayout {
        spacing: 8px;
        
        Button {
            text: "导入Excel";
            width: 80px;
        }
        
        Button {
            text: "导出结果";
            width: 80px;
        }
    }
    
