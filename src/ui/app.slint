// 主应用组件
export component App inherits Window {
    title: "图片标价工具";
    background: white;
    //preferred-width: 680px;
    width: 772px;
    min-height: 600px;

    // 调试模式：true时禁用计划卡限制
    in-out property <bool> debug-mode: true;

    // 当前选中的计划ID
    in-out property <int> current-plan-id: 0;
    // 当前选中的计划名称
    in-out property <string> current-plan-name: "";
    // 当前显示的页面
    in-out property <string> current-page: "plan";
    // 侧边栏是否展开
    in-out property <bool> sidebar-expanded: true;

    // 侧边栏切换回调，用于通知Rust调整窗口大小
    callback sidebar-toggled(bool);
    // 选择文件夹回调
    callback select-folder();

    HorizontalLayout {
        spacing: 0;

        // 侧边栏 - 支持展开/收起动画
        Rectangle {
            // 展开时120px，收起时48px
            width: sidebar-expanded ? 120px : 48px;
            background: #f5f5f5;

            // 宽度变化动画：200ms缓入缓出
            animate width {
                duration: 200ms;
                easing: ease-in-out;
            }

            VerticalLayout {
                padding: 8px;
                spacing: 8px;

                // 侧边栏切换按钮
                Rectangle {
                    height: 36px;
                    background: toggle-touch.has-hover ? #e0e0e0 : transparent;
                    border-radius: 4px;

                    toggle-touch := TouchArea {
                        clicked => {
                            sidebar-expanded = !sidebar-expanded;
                            root.sidebar-toggled(sidebar-expanded);
                        }
                    }

                    Text {
                        text: sidebar-expanded ? "◀" : "▶";
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: #666;
                    }
                }

                // 应用标题
                Rectangle {
                    height: 40px;
                    background: #1976D2;
                    border-radius: 4px;

                    if sidebar-expanded: Text {
                        text: "图片标价工具";
                        color: white;
                        font-size: 16px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if !sidebar-expanded: Text {
                        text: "📷";
                        font-size: 20px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // 计划管理按钮
                Rectangle {
                    height: 36px;
                    background: current-page == "plan" ? #e3f2fd : transparent;
                    border-radius: 4px;

                    TouchArea {
                        clicked => {
                            current-page = "plan";
                        }
                    }

                    if sidebar-expanded: Text {
                        text: "📋 添加计划";
                        color: current-page == "plan" ? #1976D2 : #666;
                        font-size: 14px;
                        font-weight: current-page == "plan" ? 700 : 400;
                        vertical-alignment: center;
                        x: 12px;
                    }
                    if !sidebar-expanded: Text {
                        text: "📋";
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: current-page == "plan" ? #1976D2 : #666;
                    }
                }

                // 分隔线
                Rectangle {
                    height: 1px;
                    background: #e0e0e0;
                }

                // 子功能标题
                if sidebar-expanded: Text {
                    text: "当前计划功能";
                    font-size: 12px;
                    color: #999;
                    height: 20px;
                }

                // 图片标价按钮
                Rectangle {
                    height: 36px;
                    background: current-page == "pricing" ? #e3f2fd : transparent;
                    border-radius: 4px;
                    opacity: (debug-mode || current-plan-id > 0) ? 1.0 : 0.5;

                    TouchArea {
                        clicked => {
                            if debug-mode || current-plan-id > 0 {
                                current-page = "pricing";
                            }
                        }
                    }

                    if sidebar-expanded: Text {
                        text: "🖼️ 图片标价";
                        color: current-page == "pricing" ? #1976D2 : #666;
                        font-size: 14px;
                        font-weight: current-page == "pricing" ? 700 : 400;
                        vertical-alignment: center;
                        x: 12px;
                    }
                    if !sidebar-expanded: Text {
                        text: "🖼️";
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: current-page == "pricing" ? #1976D2 : #666;
                    }
                }

                // 图片管理按钮
                Rectangle {
                    height: 36px;
                    background: current-page == "manage" ? #e3f2fd : transparent;
                    border-radius: 4px;
                    opacity: (debug-mode || current-plan-id > 0) ? 1.0 : 0.5;

                    TouchArea {
                        clicked => {
                            if debug-mode || current-plan-id > 0 {
                                current-page = "manage";
                            }
                        }
                    }

                    if sidebar-expanded: Text {
                        text: "📁 图片管理";
                        color: current-page == "manage" ? #1976D2 : #666;
                        font-size: 14px;
                        font-weight: current-page == "manage" ? 700 : 400;
                        vertical-alignment: center;
                        x: 12px;
                    }
                    if !sidebar-expanded: Text {
                        text: "📁";
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: current-page == "manage" ? #1976D2 : #666;
                    }
                }

                // Excel配对按钮
                Rectangle {
                    height: 36px;
                    background: current-page == "excel" ? #e3f2fd : transparent;
                    border-radius: 4px;
                    opacity: (debug-mode || current-plan-id > 0) ? 1.0 : 0.5;

                    TouchArea {
                        clicked => {
                            if debug-mode || current-plan-id > 0 {
                                current-page = "excel";
                            }
                        }
                    }

                    if sidebar-expanded: Text {
                        text: "📊 Excel配对";
                        color: current-page == "excel" ? #1976D2 : #666;
                        font-size: 14px;
                        font-weight: current-page == "excel" ? 700 : 400;
                        vertical-alignment: center;
                        x: 12px;
                    }
                    if !sidebar-expanded: Text {
                        text: "📊";
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: current-page == "excel" ? #1976D2 : #666;
                    }
                }
            }
        }

        // 主内容区域
        Rectangle {
            horizontal-stretch: 1;
            background: white;
            clip: true;
            //硬编码一个个百分比测试的不该这么搞
            width: 83%;
            VerticalLayout {
                padding: 0;
                alignment: stretch;

                if current-page == "pricing": PricingPage {
                    plan-id <=> current-plan-id;
                    select-folder => {
                        root.select-folder();
                    }
                }
                if current-page == "plan": PlanPage {
                    plan-id <=> current-plan-id;
                    plan-name <=> current-plan-name;
                }
                if current-page == "manage": ManagePage {
                    plan-id <=> current-plan-id;
                }
                if current-page == "excel": ExcelPage {
                    plan-id <=> current-plan-id;
                }
            }
        }
    }
}
