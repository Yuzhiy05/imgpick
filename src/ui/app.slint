import { Button, VerticalBox, HorizontalBox, ListView, TextEdit, LineEdit, ComboBox, ScrollView, CheckBox } from "std-widgets.slint";

// 计划项组件 - 卡片样式
export component PlanItem inherits Rectangle {
    in-out property <int> plan-id: 0;
    in-out property <string> plan-name: "";
    in-out property <bool> is-selected: false;
    in-out property <bool> is-editing: false;
    
    callback clicked();
    callback delete-clicked();
    callback rename-clicked(string);
    
    width: 160px;
    height: 80px;
    border-radius: 12px;
    background: is-selected ? #e3f2fd : touch.has-hover ? #f5f5f5 : white;
    border-width: 2px;
    border-color: is-selected ? #1976D2 : #e0e0e0;
    clip: true;
    
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    
    VerticalLayout {
        padding: 0;
        
        // 计划名称区域
        Rectangle {
            vertical-stretch: 1;
            background: transparent;
            
            if is-editing: LineEdit {
                text: plan-name;
                horizontal-stretch: 1;
                accepted(text) => { root.rename-clicked(text); }
            }
            if !is-editing: Text {
                text: plan-name;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: is-selected ? #1976D2 : #333;
                font-size: 13px;
                overflow: elide;
            }
        }
        
        // 删除按钮区域
        Rectangle {
            height: 28px;
            background: touch-del.has-hover ? #ffebee : transparent;
            
            touch-del := TouchArea {
                clicked => { root.delete-clicked(); }
            }
            
            Text {
                text: "🗑️";
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// 计划数据结构
export struct PlanData {
    id: int,
    name: string,
}

// 计划页面适配器（全局单例）
export global PlanPageAdapter {
    in-out property <[PlanData]> plans: [];
    
    callback create-plan(string);
    callback delete-plan(int);
    callback rename-plan(int, string);
    callback select-plan(int);
}

// 计划管理页面
export component PlanPage inherits VerticalLayout {
    in-out property <int> plan-id: 0;
    in-out property <string> plan-name: "";
    alignment: start;
    padding: 0;
    spacing: 12px;
    
    Text {
        text: "添加计划";
        font-size: 18px;
        font-weight: 700;
        color: #1976D2;
        height: 28px;
    }
    
    HorizontalLayout {
        height: 40px;
        spacing: 8px;
        
        new-plan-input := LineEdit {
            placeholder-text: "输入新计划名称...";
            horizontal-stretch: 1;
            accepted(text) => {
                if text != "" {
                    PlanPageAdapter.create-plan(text);
                    self.text = "";
                }
            }
        }
        
        Button {
            text: "添加";
            width: 60px;
            clicked => {
                if new-plan-input.text != "" {
                    PlanPageAdapter.create-plan(new-plan-input.text);
                    new-plan-input.text = "";
                }
            }
        }
    }
    
    Rectangle {
        vertical-stretch: 1;
        background: #fafafa;
        border-radius: 8px;
        border-width: 1px;
        border-color: #e0e0e0;
        
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            alignment: start;
            
            Text {
                text: "计划列表";
                font-size: 14px;
                font-weight: 600;
                color: #666;
                height: 24px;
            }
            
            Flickable {
                vertical-stretch: 1;
                
                GridLayout {
                    spacing: 12px;
                    
                    for plan[i] in PlanPageAdapter.plans: PlanItem {
                        row: i / 4;
                        col: mod(i, 4);
                        plan-id: plan.id;
                        plan-name: plan.name;
                        is-selected: plan.id == root.plan-id;
                        clicked => { PlanPageAdapter.select-plan(plan.id); }
                        delete-clicked => { PlanPageAdapter.delete-plan(plan.id); }
                        rename-clicked(name) => { PlanPageAdapter.rename-plan(plan.id, name); }
                    }
                }
            }
        }
    }
}

// 图片标价页面
export component PricingPage inherits VerticalBox {
    in-out property <int> plan-id: 0;
    
    Text {
        text: "图片标价";
        font-size: 18px;
        font-weight: 700;
        color: #1976D2;
    }
    
    HorizontalLayout {
        spacing: 8px;
        
        Button {
            text: "选择文件夹";
            width: 100px;
        }
        
        Button {
            text: "上一张";
            width: 70px;
        }
        
        Button {
            text: "下一张";
            width: 70px;
        }
    }
    
    Rectangle {
        vertical-stretch: 1;
        background: #f0f0f0;
        border-radius: 4px;
        
        Text {
            text: "图片显示区域";
            horizontal-alignment: center;
            vertical-alignment: center;
            color: #999;
        }
    }
    
    HorizontalLayout {
        spacing: 4px;
        
        Button { text: "4+"; width: 50px; }
        Button { text: "3+"; width: 50px; }
        Button { text: "2+"; width: 50px; }
        Button { text: "1+/+"; width: 50px; }
        Button { text: "-"; width: 50px; }
        Button { text: "?"; width: 50px; }
        Button { text: "M"; width: 50px; }
    }
    
    HorizontalLayout {
        spacing: 8px;
        
        Button {
            text: "确认标价";
            width: 80px;
        }
        
        Button {
            text: "跳过";
            width: 60px;
        }
    }
}

