import { Button, VerticalBox, HorizontalBox, ListView, TextEdit, LineEdit, ComboBox, ScrollView, CheckBox } from "std-widgets.slint";

import { PlanData, ExcelRowData, ImageCategoryData, ImageCandidate } from "structs.slint";
import { PlanPageAdapter, ManagePageAdapter, PricingPageAdapter, ExcelPageAdapter } from "globals.slint";
export { PlanData, ExcelRowData, ImageCategoryData, ImageCandidate }
export { PlanPageAdapter, ManagePageAdapter, PricingPageAdapter, ExcelPageAdapter }

import { PlanItem } from "components/plan_item.slint";
import { PlanPage } from "components/plan_page.slint";
import { ImageCategoryItem } from "components/image_category_item.slint";
import { PricingCategoryItem } from "components/pricing_category_item.slint";
import { PricingPage } from "components/pricing_page.slint";
import { ManagePage } from "components/manage_page.slint";
import { ExcelPage } from "components/excel_page.slint";

export component ImagePreviewWindow inherits Window {
    title: "图片预览";
    background: white;
    width: 600px;
    height: 500px;

    // 直接使用属性而不是依赖ExcelPageAdapter
    in-out property <image> preview-image;
    in-out property <string> preview-image-name: "";
    in-out property <string> sample-id: "";
    in-out property <string> test-time: "";
    in-out property <int> current-index: 0;
    in-out property <int> total-count: 0;

    callback close-window();
    callback confirm-match();
    callback next-image();
    callback prev-image();

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        // 标题栏
        HorizontalLayout {
            height: 32px;
            spacing: 8px;

            Text {
                text: "图片预览: " + preview-image-name;
                font-size: 14px;
                font-weight: 600;
                color: #1976D2;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Rectangle {
                width: 80px;
                height: 28px;
                background: #e8f5e9;
                border-radius: 4px;

                Text {
                    text: "选择匹配";
                    font-size: 12px;
                    color: #2e7d32;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        root.confirm-match();
                    }
                }
            }

            Rectangle {
                width: 60px;
                height: 28px;
                background: #ffebee;
                border-radius: 4px;

                Text {
                    text: "关闭";
                    font-size: 12px;
                    color: #c62828;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        root.close-window();
                    }
                }
            }
        }

        // 图片显示区域（带左右切换按钮）
        Rectangle {
            vertical-stretch: 1;
            background: #f5f5f5;
            border-radius: 4px;

            HorizontalLayout {
                vertical-stretch: 1;
                
                // 上一张按钮（仅在有多张图片时显示）
                if total-count > 1: Rectangle {
                    width: 40px;
                    height: 60px;
                    y: parent.height / 2 - 30px;
                    background: prev-touch.has-hover ? #e0e0e0 : transparent;
                    border-radius: 4px;

                    prev-touch := TouchArea {
                        clicked => {
                            root.prev-image();
                        }
                    }

                    Text {
                        text: "◀";
                        font-size: 20px;
                        color: current-index > 0 ? #333 : #ccc;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // 图片显示
                Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    Image {
                        source: preview-image;
                        image-fit: contain;
                        width: 100%;
                        height: 100%;
                    }
                }

                // 下一张按钮（仅在有多张图片时显示）
                if total-count > 1: Rectangle {
                    width: 40px;
                    height: 60px;
                    y: parent.height / 2 - 30px;
                    background: next-touch.has-hover ? #e0e0e0 : transparent;
                    border-radius: 4px;

                    next-touch := TouchArea {
                        clicked => {
                            root.next-image();
                        }
                    }

                    Text {
                        text: "▶";
                        font-size: 20px;
                        color: current-index < total-count - 1 ? #333 : #ccc;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 底部信息
        Rectangle {
            height: 24px;
            background: #f5f5f5;
            border-radius: 4px;

            HorizontalLayout {
                Text {
                    text: "样本编号: " + sample-id + " | 考察时间: " + test-time + " | " + (current-index + 1) + "/" + total-count;
                    font-size: 11px;
                    color: #666;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// 手动匹配窗口
export component ManualMatchWindow inherits Window {
    title: "匹配图片";
    background: white;
    width: 600px;
    height: 500px;

    // 属性
    in-out property <string> sample-id: "";
    in-out property <string> hole-result: "";
    in-out property <string> new-hole-result: "";
    in-out property <string> matched-image: "";
    in-out property <string> status-message: "";
    in-out property <bool> status-success: false;
    in-out property <[string]> candidate-images: [];

    callback close-window();
    callback search-images();
    callback confirm-match();
    callback preview-image();

    VerticalLayout {
        padding: 12px;
        spacing: 12px;

        // 标题
        Text {
            text: "匹配图片 - 样本ID: " + sample-id;
            font-size: 16px;
            font-weight: 700;
            color: #1976D2;
            height: 28px;
        }

        // 原孔位结果（只读）
        HorizontalLayout {
            spacing: 8px;
            height: 32px;

            Text {
                text: "原孔位结果:";
                font-size: 13px;
                color: #333;
                vertical-alignment: center;
                width: 80px;
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                background: #f5f5f5;
                border-width: 1px;
                border-color: #e0e0e0;
                border-radius: 4px;

                Text {
                    text: hole-result != "" ? hole-result : "无";
                    font-size: 12px;
                    color: #333;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }

        // 新孔位结果（可编辑）+ 搜索按钮
        HorizontalLayout {
            spacing: 8px;
            height: 32px;

            Text {
                text: "搜索孔位图片:";
                font-size: 13px;
                color: #333;
                vertical-alignment: center;
                width: 80px;
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                background: white;
                border-width: 1px;
                border-color: #bdbdbd;
                border-radius: 4px;
                clip: true;

                LineEdit {
                    text: new-hole-result;
                    width: parent.width;
                    height: parent.height;
                    edited(text) => {
                        root.new-hole-result = text;
                    }
                }
            }

            Rectangle {
                width: 70px;
                height: 28px;
                background: search-touch.has-hover ? #1565c0 : #1976D2;
                border-radius: 4px;

                Text {
                    text: "搜索";
                    font-size: 12px;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                search-touch := TouchArea {
                    clicked => { root.search-images(); }
                }
            }
        }

        // 候选图片列表
        Text {
            text: "候选图片 (" + candidate-images.length + "):";
            font-size: 12px;
            color: #666;
            height: 20px;
        }

        Rectangle {
            vertical-stretch: 1;
            background: #fafafa;
            border-width: 1px;
            border-color: #e0e0e0;
            border-radius: 4px;
            clip: true;

            if candidate-images.length == 0: Text {
                text: "点击搜索按钮查找匹配图片";
                font-size: 12px;
                color: #999;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if candidate-images.length > 0: ListView {
                for img in candidate-images: Rectangle {
                    height: 28px;
                    background: img == matched-image ? #e3f2fd : (candidate-hover.has-hover ? #f5f5f5 : transparent);
                    border-width: 1px;
                    border-color: img == matched-image ? #1976D2 : transparent;
                    border-radius: 3px;

                    candidate-hover := TouchArea {
                        clicked => {
                            root.matched-image = img;
                        }
                    }

                    Text {
                        text: img;
                        font-size: 12px;
                        color: img == matched-image ? #1976D2 : #333;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 当前选择
        HorizontalLayout {
            spacing: 8px;
            height: 28px;

            Text {
                text: "已选择:";
                font-size: 12px;
                color: #666;
                vertical-alignment: center;
                width: 60px;
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 24px;
                background: preview-touch.has-hover ? #e3f2fd : transparent;
                border-radius: 3px;

                preview-touch := TouchArea {
                    clicked => {
                        if matched-image != "" {
                            root.preview-image();
                        }
                    }
                }

                Text {
                    text: matched-image != "" ? matched-image + " (点击预览)" : "未选择";
                    font-size: 12px;
                    color: matched-image != "" ? #1976D2 : #999;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                }
            }
        }

        // 状态消息
        if status-message != "": Rectangle {
            height: 24px;
            background: status-success ? #e8f5e9 : #ffebee;
            border-radius: 4px;

            Text {
                text: status-message;
                font-size: 11px;
                color: status-success ? #2e7d32 : #c62828;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // 底部按钮
        HorizontalLayout {
            spacing: 12px;
            height: 36px;

            Rectangle {
                horizontal-stretch: 1;
                background: confirm-touch.has-hover ? #388e3c : (confirm-touch.pressed ? #2e7d32 : #4caf50);
                border-radius: 4px;

                Text {
                    text: "确认匹配";
                    font-size: 13px;
                    font-weight: 600;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                confirm-touch := TouchArea {
                    clicked => { root.confirm-match(); }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: cancel-touch.has-hover ? #d32f2f : (cancel-touch.pressed ? #b71c1c : #f44336);
                border-radius: 4px;

                Text {
                    text: "取消";
                    font-size: 13px;
                    font-weight: 600;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                cancel-touch := TouchArea {
                    clicked => { root.close-window(); }
                }
            }
        }
    }
}

// 主应用组件
export component App inherits Window {
    title: "图片标价工具";
    background: white;
    //preferred-width: 680px;
    width: 1200px;
    min-height: 800px;

    // 调试模式：true时禁用计划卡限制
    in-out property <bool> debug-mode: true;

    // 当前选中的计划ID
    in-out property <int> current-plan-id: 0;
    // 当前选中的计划名称
    in-out property <string> current-plan-name: "";
    // 当前显示的页面
    in-out property <string> current-page: "plan";
    // 侧边栏是否展开
    in-out property <bool> sidebar-expanded: true;

    // 侧边栏切换回调，用于通知Rust调整窗口大小
    callback sidebar-toggled(bool);
    // 选择文件夹回调
    callback select-folder();

    HorizontalLayout {
        spacing: 12px;

        // 侧边栏 - 支持展开/收起动画
        Rectangle {
            // 展开时120px，收起时48px
            width: sidebar-expanded ? 120px : 48px;
            background: #f5f5f5;

            // 宽度变化动画：200ms缓入缓出
            animate width {
                duration: 200ms;
                easing: ease-in-out;
            }

            VerticalLayout {
                padding: 8px;
                spacing: 8px;

                // 侧边栏切换按钮
                Rectangle {
                    height: 36px;
                    background: toggle-touch.has-hover ? #e0e0e0 : transparent;
                    border-radius: 4px;

                    toggle-touch := TouchArea {
                        clicked => {
                            sidebar-expanded = !sidebar-expanded;
                            root.sidebar-toggled(sidebar-expanded);
                        }
                    }

                    Text {
                        text: sidebar-expanded ? "◀" : "▶";
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: #666;
                    }
                }

                // 应用标题
                Rectangle {
                    height: 40px;
                    background: #1976D2;
                    border-radius: 4px;

                    if sidebar-expanded: Text {
                        text: "图片标价工具";
                        color: white;
                        font-size: 16px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if !sidebar-expanded: Text {
                        text: "📷";
                        font-size: 20px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // 计划管理按钮
                Rectangle {
                    height: 36px;
                    background: current-page == "plan" ? #e3f2fd : transparent;
                    border-radius: 4px;

                    TouchArea {
                        clicked => {
                            current-page = "plan";
                        }
                    }

                    if sidebar-expanded: Text {
                        text: "📋 添加计划";
                        color: current-page == "plan" ? #1976D2 : #666;
                        font-size: 14px;
                        font-weight: current-page == "plan" ? 700 : 400;
                        vertical-alignment: center;
                        x: 12px;
                    }
                    if !sidebar-expanded: Text {
                        text: "📋";
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: current-page == "plan" ? #1976D2 : #666;
                    }
                }

                // 分隔线
                Rectangle {
                    height: 1px;
                    background: #e0e0e0;
                }

                // 子功能标题
                if sidebar-expanded: Text {
                    text: "当前计划功能";
                    font-size: 12px;
                    color: #999;
                    height: 20px;
                }

                // 图片标价按钮
                Rectangle {
                    height: 36px;
                    background: current-page == "pricing" ? #e3f2fd : transparent;
                    border-radius: 4px;
                    opacity: (debug-mode || current-plan-id > 0) ? 1.0 : 0.5;

                    TouchArea {
                        clicked => {
                            if debug-mode || current-plan-id > 0 {
                                current-page = "pricing";
                            }
                        }
                    }

                    if sidebar-expanded: Text {
                        text: "📸 图片标价";
                        color: current-page == "pricing" ? #1976D2 : #666;
                        font-size: 14px;
                        font-weight: current-page == "pricing" ? 700 : 400;
                        vertical-alignment: center;
                        x: 12px;
                    }
                    if !sidebar-expanded: Text {
                        text: "📸";
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: current-page == "pricing" ? #1976D2 : #666;
                    }
                }

                // 图片管理按钮
                Rectangle {
                    height: 36px;
                    background: current-page == "manage" ? #e3f2fd : transparent;
                    border-radius: 4px;
                    opacity: (debug-mode || current-plan-id > 0) ? 1.0 : 0.5;

                    TouchArea {
                        clicked => {
                            if debug-mode || current-plan-id > 0 {
                                current-page = "manage";
                            }
                        }
                    }

                    if sidebar-expanded: Text {
                        text: "📁 图片管理";
                        color: current-page == "manage" ? #1976D2 : #666;
                        font-size: 14px;
                        font-weight: current-page == "manage" ? 700 : 400;
                        vertical-alignment: center;
                        x: 12px;
                    }
                    if !sidebar-expanded: Text {
                        text: "📁";
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: current-page == "manage" ? #1976D2 : #666;
                    }
                }

                // Excel配对按钮
                Rectangle {
                    height: 36px;
                    background: current-page == "excel" ? #e3f2fd : transparent;
                    border-radius: 4px;
                    opacity: (debug-mode || current-plan-id > 0) ? 1.0 : 0.5;

                    TouchArea {
                        clicked => {
                            if debug-mode || current-plan-id > 0 {
                                current-page = "excel";
                            }
                        }
                    }

                    if sidebar-expanded: Text {
                        text: "📊 Excel配对";
                        color: current-page == "excel" ? #1976D2 : #666;
                        font-size: 14px;
                        font-weight: current-page == "excel" ? 700 : 400;
                        vertical-alignment: center;
                        x: 12px;
                    }
                    if !sidebar-expanded: Text {
                        text: "📊";
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: current-page == "excel" ? #1976D2 : #666;
                    }
                }
            }
        }

        // 主内容区域
        Rectangle {
            horizontal-stretch: 1;
            background: white;
            clip: true;
            //硬编码一个个百分比测试的不该这么搞
            width: 83%;
            VerticalLayout {
                padding: 0;
                alignment: stretch;

                if current-page == "pricing": PricingPage {
                    plan-id <=> current-plan-id;
                    select-folder => {
                        root.select-folder();
                    }
                }
                if current-page == "plan": PlanPage {
                    plan-id <=> current-plan-id;
                    plan-name <=> current-plan-name;
                }
                if current-page == "manage": ManagePage {
                    plan-id <=> current-plan-id;
                    plan-name <=> current-plan-name;
                }
                if current-page == "excel": ExcelPage {
                    plan-id <=> current-plan-id;
                }
            }
        }
    }
}
