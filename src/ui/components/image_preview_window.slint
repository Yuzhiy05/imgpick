import { Button, VerticalBox, HorizontalBox, ListView, TextEdit, LineEdit, ComboBox, ScrollView, CheckBox } from "std-widgets.slint";

export component ImagePreviewWindow inherits Window {
    title: "图片预览";
    background: white;
    width: 600px;
    height: 500px;

    // 直接使用属性而不是依赖ExcelPageAdapter
    in-out property <image> preview-image;
    in-out property <string> preview-image-name: "";
    in-out property <string> sample-id: "";
    in-out property <string> test-time: "";
    in-out property <int> current-index: 0;
    in-out property <int> total-count: 0;

    callback close-window();
    callback confirm-match();
    callback next-image();
    callback prev-image();

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        // 标题栏
        HorizontalLayout {
            height: 32px;
            spacing: 8px;

            Text {
                text: "图片预览: " + preview-image-name;
                font-size: 14px;
                font-weight: 600;
                color: #1976D2;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Rectangle {
                width: 80px;
                height: 28px;
                background: #e8f5e9;
                border-radius: 4px;

                Text {
                    text: "选择匹配";
                    font-size: 12px;
                    color: #2e7d32;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        root.confirm-match();
                    }
                }
            }

            Rectangle {
                width: 60px;
                height: 28px;
                background: #ffebee;
                border-radius: 4px;

                Text {
                    text: "关闭";
                    font-size: 12px;
                    color: #c62828;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        root.close-window();
                    }
                }
            }
        }

        // 图片显示区域（带左右切换按钮）
        Rectangle {
            vertical-stretch: 1;
            background: #f5f5f5;
            border-radius: 4px;

            HorizontalLayout {
                vertical-stretch: 1;
                
                // 上一张按钮（仅在有多张图片时显示）
                if total-count > 1: Rectangle {
                    width: 40px;
                    height: 60px;
                    y: parent.height / 2 - 30px;
                    background: prev-touch.has-hover ? #e0e0e0 : transparent;
                    border-radius: 4px;

                    prev-touch := TouchArea {
                        clicked => {
                            root.prev-image();
                        }
                    }

                    Text {
                        text: "◀";
                        font-size: 20px;
                        color: current-index > 0 ? #333 : #ccc;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // 图片显示
                Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    Image {
                        source: preview-image;
                        image-fit: contain;
                        width: 100%;
                        height: 100%;
                    }
                }

                // 下一张按钮（仅在有多张图片时显示）
                if total-count > 1: Rectangle {
                    width: 40px;
                    height: 60px;
                    y: parent.height / 2 - 30px;
                    background: next-touch.has-hover ? #e0e0e0 : transparent;
                    border-radius: 4px;

                    next-touch := TouchArea {
                        clicked => {
                            root.next-image();
                        }
                    }

                    Text {
                        text: "▶";
                        font-size: 20px;
                        color: current-index < total-count - 1 ? #333 : #ccc;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 底部信息
        Rectangle {
            height: 24px;
            background: #f5f5f5;
            border-radius: 4px;

            HorizontalLayout {
                Text {
                    text: "样本编号: " + sample-id + " | 考察时间: " + test-time + " | " + (current-index + 1) + "/" + total-count;
                    font-size: 11px;
                    color: #666;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
