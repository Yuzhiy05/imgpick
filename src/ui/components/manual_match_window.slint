import { Button, VerticalBox, HorizontalBox, ListView, TextEdit, LineEdit, ComboBox, ScrollView, CheckBox } from "std-widgets.slint";

export component ManualMatchWindow inherits Window {
    title: "匹配图片";
    background: white;
    width: 600px;
    height: 500px;

    // 属性
    in-out property <string> sample-id: "";
    in-out property <string> hole-result: "";
    in-out property <string> new-hole-result: "";
    in-out property <string> matched-image: "";
    in-out property <string> status-message: "";
    in-out property <bool> status-success: false;
    in-out property <[string]> candidate-images: [];

    callback close-window();
    callback search-images();
    callback confirm-match();
    callback preview-image();

    VerticalLayout {
        padding: 12px;
        spacing: 12px;

        // 标题
        Text {
            text: "匹配图片 - 样本ID: " + sample-id;
            font-size: 16px;
            font-weight: 700;
            color: #1976D2;
            height: 28px;
        }

        // 原孔位结果（只读）
        HorizontalLayout {
            spacing: 8px;
            height: 32px;

            Text {
                text: "原孔位结果:";
                font-size: 13px;
                color: #333;
                vertical-alignment: center;
                width: 80px;
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                background: #f5f5f5;
                border-width: 1px;
                border-color: #e0e0e0;
                border-radius: 4px;

                Text {
                    text: hole-result != "" ? hole-result : "无";
                    font-size: 12px;
                    color: #333;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }

        // 新孔位结果（可编辑）+ 搜索按钮
        HorizontalLayout {
            spacing: 8px;
            height: 32px;

            Text {
                text: "搜索孔位图片:";
                font-size: 13px;
                color: #333;
                vertical-alignment: center;
                width: 80px;
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                background: white;
                border-width: 1px;
                border-color: #bdbdbd;
                border-radius: 4px;
                clip: true;

                LineEdit {
                    text: new-hole-result;
                    width: parent.width;
                    height: parent.height;
                    edited(text) => {
                        root.new-hole-result = text;
                    }
                }
            }

            Rectangle {
                width: 70px;
                height: 28px;
                background: search-touch.has-hover ? #1565c0 : #1976D2;
                border-radius: 4px;

                Text {
                    text: "搜索";
                    font-size: 12px;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                search-touch := TouchArea {
                    clicked => { root.search-images(); }
                }
            }
        }

        // 候选图片列表
        Text {
            text: "候选图片 (" + candidate-images.length + "):";
            font-size: 12px;
            color: #666;
            height: 20px;
        }

        Rectangle {
            vertical-stretch: 1;
            background: #fafafa;
            border-width: 1px;
            border-color: #e0e0e0;
            border-radius: 4px;
            clip: true;

            if candidate-images.length == 0: Text {
                text: "点击搜索按钮查找匹配图片";
                font-size: 12px;
                color: #999;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if candidate-images.length > 0: ListView {
                for img in candidate-images: Rectangle {
                    height: 28px;
                    background: img == matched-image ? #e3f2fd : (candidate-hover.has-hover ? #f5f5f5 : transparent);
                    border-width: 1px;
                    border-color: img == matched-image ? #1976D2 : transparent;
                    border-radius: 3px;

                    candidate-hover := TouchArea {
                        clicked => {
                            root.matched-image = img;
                        }
                    }

                    Text {
                        text: img;
                        font-size: 12px;
                        color: img == matched-image ? #1976D2 : #333;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 当前选择
        HorizontalLayout {
            spacing: 8px;
            height: 28px;

            Text {
                text: "已选择:";
                font-size: 12px;
                color: #666;
                vertical-alignment: center;
                width: 60px;
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 24px;
                background: preview-touch.has-hover ? #e3f2fd : transparent;
                border-radius: 3px;

                preview-touch := TouchArea {
                    clicked => {
                        if matched-image != "" {
                            root.preview-image();
                        }
                    }
                }

                Text {
                    text: matched-image != "" ? matched-image + " (点击预览)" : "未选择";
                    font-size: 12px;
                    color: matched-image != "" ? #1976D2 : #999;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                }
            }
        }

        // 状态消息
        if status-message != "": Rectangle {
            height: 24px;
            background: status-success ? #e8f5e9 : #ffebee;
            border-radius: 4px;

            Text {
                text: status-message;
                font-size: 11px;
                color: status-success ? #2e7d32 : #c62828;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // 底部按钮
        HorizontalLayout {
            spacing: 12px;
            height: 36px;

            Rectangle {
                horizontal-stretch: 1;
                background: confirm-touch.has-hover ? #388e3c : (confirm-touch.pressed ? #2e7d32 : #4caf50);
                border-radius: 4px;

                Text {
                    text: "确认匹配";
                    font-size: 13px;
                    font-weight: 600;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                confirm-touch := TouchArea {
                    clicked => { root.confirm-match(); }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: cancel-touch.has-hover ? #d32f2f : (cancel-touch.pressed ? #b71c1c : #f44336);
                border-radius: 4px;

                Text {
                    text: "取消";
                    font-size: 13px;
                    font-weight: 600;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                cancel-touch := TouchArea {
                    clicked => { root.close-window(); }
                }
            }
        }
    }
}
