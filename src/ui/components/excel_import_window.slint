import { Button, ScrollView, LineEdit, ComboBox } from "std-widgets.slint";
import { ExcelRowData } from "../structs.slint";

// Excel预览列信息
export struct ExcelPreviewColumn {
    name: string,
    index: int,
    sample-values: [string],
}

export component ExcelImportWindow inherits Window {
    title: "导入Excel - 选择文件和列映射";
    background: white;
    width: 800px;
    height: 600px;

    // 文件信息
    in-out property <string> file-path: "";
    in-out property <string> file-name: "";
    in-out property <int> total-row-count: 0;
    
    // 列映射配置
    in-out property <[string]> available-columns: [];
    in-out property <string> sample-id-column: "";
    in-out property <string> hole-result-start-column: "";
    in-out property <string> hole-result-end-column: "";
    in-out property <string> test-time-column: "";
    
    // 预览数据
    in-out property <[ExcelRowData]> preview-rows: [];
    
    // 完整预览数据（支持21列）
    in-out property <[string]> preview-headers: [];
    in-out property <[string]> preview-cell-values: [];
    in-out property <[string]> preview-col-letters: [];
    in-out property <int> preview-row-count: 0;
    in-out property <int> preview-col-count: 0;
    
    // 目标Card选择
    in-out property <int> target-card: 0;
    in-out property <[string]> card-names: ["血型", "抗筛", "交叉配血"];
    
    // 状态
    in-out property <string> status-message: "";
    in-out property <bool> status-success: false;
    
    // 回调
    callback close-window();
    callback select-file();
    callback confirm-import();
    callback refresh-preview();

    VerticalLayout {
        padding: 12px;
        spacing: 12px;

        // 标题栏
        HorizontalLayout {
            height: 32px;
            spacing: 8px;

            Text {
                text: "导入Excel - 选择文件和列映射";
                font-size: 16px;
                font-weight: 700;
                color: #1976D2;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }

        // 文件信息栏
        HorizontalLayout {
            height: 32px;
            spacing: 8px;

            Text {
                text: "文件:";
                font-size: 13px;
                color: #333;
                vertical-alignment: center;
                width: 40px;
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                background: #f5f5f5;
                border-width: 1px;
                border-color: #e0e0e0;
                border-radius: 4px;

                Text {
                    text: file-name != "" ? file-name + " (" + total-row-count + "行)" : "未选择文件";
                    font-size: 12px;
                    color: #333;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                    x: 8px;
                }
            }

            Rectangle {
                width: 80px;
                height: 28px;
                background: select-touch.has-hover ? #1565c0 : #1976D2;
                border-radius: 4px;

                Text {
                    text: "选择文件";
                    font-size: 12px;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                select-touch := TouchArea {
                    clicked => {
                        root.select-file();
                    }
                }
            }
        }

        // 目标Card选择
        HorizontalLayout {
            height: 32px;
            spacing: 8px;

            Text {
                text: "导入到:";
                font-size: 13px;
                color: #333;
                vertical-alignment: center;
                width: 60px;
            }

            ComboBox {
                model: card-names;
                current-index: target-card;
                width: 120px;
                selected(value) => {
                    root.target-card = self.current-index;
                }
            }

            Rectangle { horizontal-stretch: 1; }
        }

        // 列映射配置区
        Rectangle {
            height: 160px;
            background: #fafafa;
            border-width: 1px;
            border-color: #e0e0e0;
            border-radius: 4px;

            VerticalLayout {
                padding: 8px;
                spacing: 8px;

                Text {
                    text: "列映射配置（选择单元格位置，如A1、B2）:";
                    font-size: 13px;
                    font-weight: 600;
                    color: #333;
                    height: 20px;
                }

                // 样本编号列
                HorizontalLayout {
                    height: 24px;
                    spacing: 8px;

                    Text {
                        text: "样本编号列:";
                        font-size: 12px;
                        color: #333;
                        vertical-alignment: center;
                        width: 80px;
                    }

                    ComboBox {
                        model: available-columns;
                        current-value: sample-id-column;
                        width: 200px;
                        selected(value) => {
                            root.sample-id-column = value;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }

                // 孔位结果列（范围选择）
                HorizontalLayout {
                    height: 24px;
                    spacing: 8px;

                    Text {
                        text: "孔位结果列:";
                        font-size: 12px;
                        color: #333;
                        vertical-alignment: center;
                        width: 80px;
                    }

                    ComboBox {
                        model: available-columns;
                        current-value: hole-result-start-column;
                        width: 200px;
                        selected(value) => {
                            root.hole-result-start-column = value;
                        }
                    }

                    Text {
                        text: "至";
                        font-size: 12px;
                        color: #333;
                        vertical-alignment: center;
                        width: 20px;
                    }

                    ComboBox {
                        model: available-columns;
                        current-value: hole-result-end-column;
                        width: 200px;
                        selected(value) => {
                            root.hole-result-end-column = value;
                        }
                    }
                }

                // 考察时间列
                HorizontalLayout {
                    height: 24px;
                    spacing: 8px;

                    Text {
                        text: "考察时间列:";
                        font-size: 12px;
                        color: #333;
                        vertical-alignment: center;
                        width: 80px;
                    }

                    ComboBox {
                        model: available-columns;
                        current-value: test-time-column;
                        width: 200px;
                        selected(value) => {
                            root.test-time-column = value;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }

        // 预览表格区域（列名作为第一行数据，水平滚动自然同步）
        Rectangle {
            vertical-stretch: 1;
            background: white;
            border-width: 1px;
            border-color: #e0e0e0;
            border-radius: 4px;
            clip: true;

            if preview-cell-values.length == 0: Text {
                text: "请先选择Excel文件";
                font-size: 12px;
                color: #999;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if preview-cell-values.length > 0: ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    // 第一行：列名（A、B、C...U + 列名）
                    HorizontalLayout {
                        height: 28px;

                        // 行号（显示#）
                        Rectangle {
                            width: 40px;
                            height: 100%;
                            background: #bbdefb;

                            Text {
                                text: "#";
                                font-size: 11px;
                                font-weight: 700;
                                color: #1565c0;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // 列名字母
                        for letter in preview-col-letters: Rectangle {
                            width: 80px;
                            height: 100%;
                            background: #bbdefb;

                            Text {
                                text: letter;
                                font-size: 11px;
                                font-weight: 700;
                                color: #1565c0;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 第二行：列标题名
                    HorizontalLayout {
                        height: 28px;

                        // 行号（显示0）
                        Rectangle {
                            width: 40px;
                            height: 100%;
                            background: #e3f2fd;

                            Text {
                                text: "0";
                                font-size: 11px;
                                font-weight: 600;
                                color: #1976D2;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // 列标题名
                        for header in preview-headers: Rectangle {
                            width: 80px;
                            height: 100%;
                            background: #e3f2fd;

                            Text {
                                text: header;
                                font-size: 10px;
                                font-weight: 600;
                                color: #1976D2;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    // 数据行（从第1行开始）
                    for row-index in preview-row-count: HorizontalLayout {
                        height: 28px;

                        // 行号
                        Rectangle {
                            width: 40px;
                            height: 100%;
                            background: Math.mod(row-index, 2) == 0 ? #e3f2fd : #f5f5f5;

                            Text {
                                text: row-index + 1;
                                font-size: 11px;
                                font-weight: 600;
                                color: #1976D2;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // 单元格数据
                        for col-index in preview-col-count: Rectangle {
                            width: 80px;
                            height: 100%;
                            background: Math.mod(row-index, 2) == 0 ? #fafafa : white;

                            Text {
                                text: (row-index * preview-col-count + col-index) < preview-cell-values.length ? preview-cell-values[row-index * preview-col-count + col-index] : "";
                                font-size: 10px;
                                color: #333;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }

        // 状态消息
        if status-message != "": Rectangle {
            height: 24px;
            background: status-success ? #e8f5e9 : #ffebee;
            border-radius: 4px;

            Text {
                text: status-message;
                font-size: 11px;
                color: status-success ? #2e7d32 : #c62828;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // 底部按钮
        HorizontalLayout {
            spacing: 12px;
            height: 36px;

            Rectangle {
                horizontal-stretch: 1;
                background: confirm-touch.has-hover ? #388e3c : #4caf50;
                border-radius: 4px;

                Text {
                    text: "确认导入";
                    font-size: 13px;
                    font-weight: 600;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                confirm-touch := TouchArea {
                    clicked => { root.confirm-import(); }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: cancel2-touch.has-hover ? #d32f2f : #f44336;
                border-radius: 4px;

                Text {
                    text: "取消";
                    font-size: 13px;
                    font-weight: 600;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                cancel2-touch := TouchArea {
                    clicked => { root.close-window(); }
                }
            }
        }
    }
}
